# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored. This example file is not — never put real values
# here.
#
# Both variables are NEXT_PUBLIC_, meaning they are inlined into the static
# build and visible in page source. That is correct for both: a Formspree form
# ID is a public endpoint by design, and a booking URL is a public link. Do NOT
# add any secret with a NEXT_PUBLIC_ prefix.
#
# Because these are baked in at build time, changing either one requires a
# rebuild and redeploy — restarting the dev server is not enough.
# ---------------------------------------------------------------------------

# Formspree form ID — the part after /f/ in your form's endpoint URL.
# Find it at https://formspree.io → your form → Integration → the endpoint
# reads https://formspree.io/f/xxxxxxxx — copy just the xxxxxxxx.
# Without this, the contact form renders disabled with a visible setup notice.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional. Booking link for the hero's secondary CTA (Cal.com, Calendly, etc).
# Leave empty and the button is omitted entirely rather than rendering dead.
NEXT_PUBLIC_CAL_URL=
