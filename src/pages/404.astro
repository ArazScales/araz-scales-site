---
/**
 * 404. Added on request, since CLAUDE.md section 7 says to ask before adding
 * any page beyond the homepage and the four policy pages.
 *
 * Deliberately short. Somebody who lands here wanted something else, so the
 * page says what happened in one line and then gets out of the way with the
 * two links that are actually useful: the homepage, and the contact section.
 * No search box, because a five page site has nothing to search.
 *
 * Astro writes this to dist/404.html and Vercel serves it for any unmatched
 * path. It is not in the sitemap and it carries noindex, so the address it
 * happens to be reached at is never claimed as a real page.
 */
import Base from "../layouts/Base.astro";
import { site } from "../content/site";

const copy = site.notFound;
---

<Base
  title={`${copy.title}: ${site.meta.title}`}
  description={copy.description}
  path="/404"
  noindex
>
  <section class="section theme-dark">
    <div class="wrap notfound">
      <div class="stack" style="--flow: 1.25rem">
        <h1>{copy.heading}</h1>
        <p class="hero-lede">{copy.body}</p>
        <div class="actions" style="align-items: center; margin-top: 1.5rem">
          <a class="button button-primary" href="/">{copy.home}</a>
          <a class="link" href="/#contact">{copy.contact}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
