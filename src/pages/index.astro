---
/**
 * The homepage. Everything the brief asks for is on this one page, in the
 * order a visitor asks for it: what is this, what does it cost, how does it
 * work, who are you, the awkward questions, and then the form.
 *
 * Section order is deliberate. Price comes second because it is the thing an
 * owner wants and the thing an agency site hides.
 *
 * THE GROWTH MOTIF. The logo is an "A" built from rising bars with a line and
 * three ring nodes through them. That shape drives the whole page and it is
 * used exactly three ways, which is the budget: the hero bars rise once on
 * load, the process timeline is the growth line drawing itself, and the ring
 * node marks every section heading. Nothing else moves except on hover and
 * focus. Every one of the three is off under prefers-reduced-motion.
 */
import Base from "../layouts/Base.astro";
import Record from "../components/Record.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../content/site";
import { plans, pricingNote, planById } from "../content/pricing";
import { business, founders, initials } from "../config/business";
import { professionalService, faqPage } from "../content/structured-data";

/** The tier the page leads on. Read by id, never by position. */
const featured = planById("website");
---

<Base
  title={site.meta.title}
  description={site.meta.description}
  path="/"
  jsonLd={[professionalService(), faqPage()]}
>
  <!-- ------------------------------------------------------------- hero -->
  <section class="row hero band grid-ground" aria-labelledby="hero-heading">
    <div class="wrap hero-inner">
      <div class="stack hero-copy" style="--flow: 1.25rem">
        <!-- The eyebrow types its way through the three things we sell.
             It sits here rather than under the h1 because the h1 already
             opens "We build websites", and a rotating line beneath it
             reading "We build websites" said the same thing twice.

             Two layers. A screen reader gets the full eyebrow as one static
             phrase, which is the sentence the rotation adds up to. The
             visible half is hidden from assistive tech because a word
             changing every two seconds under a live region would interrupt
             whatever the visitor was actually reading.

             The first word is server rendered, so the line is complete
             before any script runs and stays complete if none ever does. -->
        <p class="hero-eyebrow mono">
          <span class="visually-hidden">{site.hero.eyebrow}</span>
          <span class="rotator" aria-hidden="true"
            ><span
              class="rotator-word"
              id="rotator"
              data-words={JSON.stringify(site.hero.rotate)}>{site.hero.rotate[0]}</span
            ><span class="rotator-caret"></span></span
          >
        </p>

        <h1 id="hero-heading">{site.hero.heading}</h1>

        <p class="lede muted">{site.hero.lede}</p>
      </div>

      <!-- The price, in the warm accent, sized to be the loudest thing in the
           band after the headline. It is a direct child of the grid rather
           than grouped with the chart, so that on a phone it can sit between
           the headline and the buttons: stacked the other way round, the
           figure fell below the fold and the first price a visitor met was
           the one in the pricing section much further down. -->
      <p class="hero-price">
        <span class="figure tabular">{featured.amount}</span>
        <span class="figure-unit">{site.hero.priceNote}</span>
      </p>

      <div class="hero-cta">
        <a class="button button-primary" href="#contact">{site.hero.action}</a>
        <a class="button" href="#services">See pricing</a>
      </div>

      <!-- The logo's own shape, rebuilt as four bars, a growth line and ring
           nodes. Decorative: it repeats the price and the headline beside it
           and says nothing new, so it is hidden from assistive tech rather
           than given alt text nobody needs. -->
      <svg
        class="hero-chart"
        viewBox="0 0 220 120"
        role="presentation"
        aria-hidden="true"
        focusable="false"
      >
        <g class="hero-bars">
          <rect x="8" y="76" width="34" height="44" rx="3" style="--i: 0" />
          <rect x="58" y="58" width="34" height="62" rx="3" style="--i: 1" />
          <rect x="108" y="34" width="34" height="86" rx="3" style="--i: 2" />
          <rect x="158" y="10" width="34" height="110" rx="3" style="--i: 3" />
        </g>
        <polyline
          class="hero-line"
          pathLength="1"
          points="25,84 75,66 125,42 175,18"
          fill="none"
        />
        <g class="hero-nodes">
          <circle cx="25" cy="84" r="7" style="--i: 0" />
          <circle cx="75" cy="66" r="7" style="--i: 1" />
          <circle cx="125" cy="42" r="7" style="--i: 2" />
          <circle cx="175" cy="18" r="7" style="--i: 3" />
        </g>
      </svg>
    </div>
  </section>

  <!-- --------------------------------------------------- services + price -->
  <Record id="services" question={site.services.question}>
    <div class="stack section-intro" style="--flow: 0.875rem" data-reveal>
      <p class="answer">{site.services.heading}</p>
      <p class="muted">{site.services.intro}</p>
    </div>

    <ul class="plans">
      {
        plans.map((plan, index) => (
          <li
            class:list={["plan", { "plan-featured": plan.id === featured.id }]}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            {/* Not a claim about sales or popularity, which we could not
                prove. It repeats what the h1 at the top of the page already
                says we do, which is the only thing that makes this tier the
                one the page leads on. */}
            {plan.id === featured.id && (
              <p class="plan-flag mono">Our main service</p>
            )}

            <div class="plan-head">
              <h3>{plan.name}</h3>
              <p class="plan-price">
                <span class="figure tabular">{plan.amount}</span>
                <span class="figure-unit">{plan.unit}</span>
              </p>
              <p class="plan-summary">{plan.summary}</p>
            </div>

            {/* A single service: one list, one timeline. */}
            {plan.includes && (
              <ul class="ticks">
                {plan.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}

            {/* One service, two kinds of work. Each strand gets its own
                deliverables and its own timeline, so a buyer sees everything
                the monthly fee covers without $500 being printed twice. */}
            {plan.parts?.map((part) => (
              <div class="plan-part">
                <h4>{part.name}</h4>
                <p class="small muted">{part.summary}</p>
                <ul class="ticks">
                  {part.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="plan-fact">
                  <span class="plan-fact-label mono">How long</span>
                  {part.timeline}
                </p>
              </div>
            ))}

            <div class="plan-facts">
              <p class="plan-fact">
                <span class="plan-fact-label mono">Payment</span>
                {plan.payment}
              </p>
              {plan.timeline && (
                <p class="plan-fact">
                  <span class="plan-fact-label mono">How long</span>
                  {plan.timeline}
                </p>
              )}
            </div>

            <p class="plan-excludes">{plan.excludes}</p>

            {/* Every card ends at the form. The featured one gets the amber
                fill and the other two are outlined, so the page still has a
                single loudest button rather than three competing. */}
            <p class="plan-action">
              <a
                class:list={[
                  "button",
                  plan.id === featured.id ? "button-primary" : "button-secondary",
                ]}
                href="#contact"
              >
                {site.hero.action}
                <span class="visually-hidden">{` about the ${plan.name.toLowerCase()}`}</span>
              </a>
            </p>
          </li>
        ))
      }
    </ul>

    <p class="small muted plan-note">{pricingNote}</p>
  </Record>

  <!-- ---------------------------------------------------------- process -->
  <Record id="process" question={site.process.question}>
    <div class="stack section-intro" style="--flow: 0.875rem" data-reveal>
      <p class="answer">{site.process.heading}</p>
      <p class="muted">{site.process.intro}</p>
    </div>

    {/* The growth line as a timeline. On a wide screen the five nodes climb
        left to right the way the line climbs through the logo, and the line
        joining them draws itself once the section is on screen. Below 64rem
        the whole thing turns vertical and the rise is dropped, because five
        columns of prose do not fit on a phone and a rising line read top to
        bottom means nothing.

        The line is decorative. The numbers it connects are in the list itself,
        marked up as an ordered list, so the sequence survives with no CSS and
        no script. */}
    <div class="timeline">
      <svg
        class="timeline-track"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        role="presentation"
        aria-hidden="true"
        focusable="false"
      >
        <polyline
          class="timeline-line"
          points="0,100 25,75 50,50 75,25 100,0"
          fill="none"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <ol class="steps">
        {
          site.process.steps.map((step, index) => (
            <li class="step" style={`--rise: ${index}; --reveal-delay: ${index * 80}ms`} data-reveal>
              <span class="step-node" aria-hidden="true" />
              <p class="step-number mono" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3>
                <span class="visually-hidden">{`Step ${index + 1}. `}</span>
                {step.title}
              </h3>
              <p class="small muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="process-note">{site.process.note}</p>
  </Record>

  <!-- ------------------------------------------------------------- team -->
  <Record id="team" question={site.team.question} deep>
    <div class="stack section-intro" style="--flow: 0.875rem" data-reveal>
      <p class="answer">{site.team.heading}</p>
      <p class="muted">{site.team.intro}</p>
    </div>

    <ul class="founders">
      {
        founders.map((person, index) => (
          <li class="founder" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            {/* PHOTO. No headshots have been supplied, so every card shows
                initials. This is the finished state, not a gap: the circle is
                sized and coloured and the card does not change shape when a
                real photo replaces it. To add one, see the `photo` note in
                src/config/business.ts. */}
            {person.photo ? (
              <img
                class="founder-photo"
                src={`/team/${person.photo}`}
                alt={`${person.name}, who handles ${person.owns.toLowerCase()} at ${business.name}.`}
                width="88"
                height="88"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <p class="founder-initials" aria-hidden="true">
                {initials(person.name)}
              </p>
            )}

            <h3>{person.name}</h3>
            <p class="founder-owns mono">{person.owns}</p>
            <p class="small muted founder-detail">{person.detail}</p>

            <p class="founder-links">
              <a
                class="button button-secondary button-small"
                href={person.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn
                <span class="visually-hidden">{`, ${person.name}, opens in a new tab`}</span>
              </a>
              {person.site && (
                <a
                  class="button button-secondary button-small"
                  href={person.site}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Personal site
                  <span class="visually-hidden">{`, ${person.name}, opens in a new tab`}</span>
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="team-note">{site.team.note}</p>
  </Record>

  <!-- -------------------------------------------------------------- faq -->
  <Record id="faq" question={site.faq.question}>
    <div class="stack section-intro" style="--flow: 0.875rem" data-reveal>
      <p class="answer">{site.faq.heading}</p>
    </div>

    {/* Native details and summary rather than a scripted accordion. It is
        keyboard operable, announced as expanded or collapsed, and findable by
        the browser's own find-in-page with no JavaScript at all. Each one
        opens and closes independently: there is no name attribute grouping
        them, because a visitor comparing the price answer with the refund
        answer should not have the first one snap shut. */}
    <div class="faq">
      {
        site.faq.items.map((item, index) => (
          <details class="faq-item" data-reveal style={`--reveal-delay: ${index * 50}ms`}>
            <summary>
              <span class="faq-q">{item.q}</span>
              <span class="faq-sign" aria-hidden="true" />
            </summary>
            <div class="faq-a">
              <p>{item.a}</p>
              {"link" in item && item.link && (
                <p>
                  <a class="link" href={item.link.href}>
                    {item.link.label}
                  </a>
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </Record>

  <!-- ---------------------------------------------------------- contact -->
  <Record id="contact" question={site.contact.question} grid>
    <ContactForm />
    <p class="small muted contact-alt">
      You can email us directly at{" "}
      <a class="link" href={`mailto:${business.email}`}>{business.email}</a> if
      you would rather not use a form.
    </p>
  </Record>
</Base>

<style>
  /* ------------------------------------------------------------------ hero */

  .hero {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(3rem, 8vw, 5.5rem);
  }

  /* Phone first: one column, in DOM order. Headline, then the price, then
     the buttons, then the chart. The figure is above the fold that way. */
  .hero-inner {
    display: grid;
    gap: clamp(1.75rem, 5vw, 2.5rem);
    align-items: start;
  }

  /* Two columns once there is room: headline and buttons down the left, price
     and chart down the right. Named areas rather than source order, because
     the order that works on a phone is not the order that works here. */
  @media (min-width: 58rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas:
        "copy  price"
        "cta   chart";
      align-items: center;
      column-gap: clamp(2.5rem, 6vw, 4rem);
      row-gap: clamp(1.75rem, 4vw, 2.75rem);
    }

    .hero-copy {
      grid-area: copy;
    }

    .hero-price {
      grid-area: price;
      justify-self: end;
      text-align: right;
    }

    .hero-cta {
      grid-area: cta;
    }

    .hero-chart {
      grid-area: chart;
      justify-self: end;
    }
  }

  .hero h1 {
    font-size: clamp(2.375rem, 7vw, 4.75rem);
    font-weight: 780;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 15ch;
  }

  /* The rotating line. Mono, so the word changing width does not shift the
     rhythm of a proportional face, and blue so it reads as a label rather than
     a second sentence competing with the h1. */
  .hero-eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.14em;
  }

  .rotator {
    display: inline-flex;
    align-items: baseline;
  }

  /* Inline-block with a floor wide enough for the longest word, so the caret
     and everything after it hold still while the word types. Without it the
     line reflows on every keystroke, which is layout shift the performance
     floor forbids. Widen this if a longer word is ever added to the list. */
  .rotator-word {
    display: inline-block;
    min-width: 8ch;
    color: var(--blue-bright);
  }

  /* The caret. An inline block rather than a text character, so it cannot be
     selected, copied or read out, and so its height is set by the line rather
     than by a glyph. */
  .rotator-caret {
    display: inline-block;
    width: 0.45rem;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: -0.16em;
    background: var(--blue);
    animation: blink 1.1s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero .lede {
    max-width: 34ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* Full width and stacked on a narrow phone. Side by side they did not fit
     at 375px, so they wrapped to two lines of different widths, which reads as
     an accident rather than as two choices. */
  @media (max-width: 30rem) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .hero-price {
    max-width: none;
  }

  .hero-price .figure {
    font-size: clamp(4rem, 13vw, 7.5rem);
  }

  .hero-price .figure-unit {
    max-width: 32ch;
  }

  .hero-chart {
    width: 100%;
    max-width: 17rem;
    height: auto;
  }

  @media (min-width: 58rem) {
    .hero-price .figure-unit {
      margin-left: auto;
    }
  }

  /* The bars grow out of the baseline, one after another, once. This is the
     page load moment and there is no second one. */
  .hero-bars rect {
    fill: var(--blue);
    opacity: 0.85;
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(0);
    animation: bar-rise 620ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(120ms + var(--i) * 110ms);
  }

  @keyframes bar-rise {
    to { transform: scaleY(1); }
  }

  .hero-line {
    stroke: var(--amber);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* pathLength normalises the geometry to 1, so the dash values do not have
       to be recomputed if the points move. */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 900ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
    animation-delay: 420ms;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  .hero-nodes circle {
    fill: var(--deep);
    stroke: var(--amber);
    stroke-width: 3;
    opacity: 0;
    animation: node-in 320ms ease forwards;
    animation-delay: calc(620ms + var(--i) * 130ms);
  }

  @keyframes node-in {
    to { opacity: 1; }
  }

  /* Nothing starts. The bars, the line and the nodes are drawn in their
     finished state rather than animated into it. */
  @media (prefers-reduced-motion: reduce) {
    .hero-bars rect {
      transform: none;
      animation: none;
    }

    .hero-line {
      stroke-dashoffset: 0;
      animation: none;
    }

    .hero-nodes circle {
      opacity: 1;
      animation: none;
    }

    .rotator-caret {
      animation: none;
    }
  }

  /* --------------------------------------------------------------- shared */

  .section-intro {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  /* --------------------------------------------------------------- plans */

  .plans {
    display: grid;
    gap: 1.25rem;
    /* Each card is its own height. Stretching them to match the tallest put a
       315px void between the last line of the $100 card and its button, which
       reads as a rendering fault rather than as alignment. A ragged bottom
       edge across three cards of honestly different length is the better
       trade. */
    align-items: start;
  }

  @media (min-width: 46rem) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: clamp(1.5rem, 3.5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--lift);
  }

  /* The one the page leads on. Blue edge, blue glow, and it sits a little
     proud of the other two. The flag above it says why, in words, so the
     reason is not carried by the colour alone. */
  .plan-featured {
    border-color: var(--blue);
    box-shadow: var(--glow-blue), var(--lift);
  }

  @media (min-width: 68rem) {
    .plan-featured {
      /* Only on the three across layout. Stacked, a card shifted up by a few
         pixels reads as a mistake rather than as emphasis. */
      transform: translateY(-0.75rem);
    }
  }

  .plan-flag {
    margin: -0.25rem 0 -0.5rem;
    color: var(--amber);
  }

  .plan-head h3 {
    font-size: 1.25rem;
  }

  .plan-price {
    margin-top: 0.75rem;
  }

  .plan-summary {
    margin-top: 0.875rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* A short blue rule rather than a bullet or an icon, matching the lists on
     the policy pages so the whole site marks a list one way. */
  .ticks li {
    position: relative;
    padding-left: 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: var(--measure);
  }

  .ticks li + li {
    margin-top: 0.5rem;
  }

  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.5rem;
    height: 2px;
    border-radius: 1px;
    background: var(--blue);
  }

  .plan-part {
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
  }

  .plan-part > * + * {
    margin-top: 0.625rem;
  }

  .plan-part h4 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.005em;
  }

  .plan-facts {
    display: grid;
    gap: 0.875rem;
  }

  .plan-fact {
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: var(--measure);
  }

  .plan-fact-label {
    display: block;
    margin-bottom: 0.1875rem;
  }

  .plan-excludes {
    padding-left: 0.875rem;
    border-left: 2px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .plan-action {
    margin-top: 0.25rem;
    max-width: none;
  }

  .plan-action .button {
    width: 100%;
  }

  .plan-note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* ------------------------------------------------------------ timeline */

  .timeline {
    position: relative;
  }

  /* --- vertical, the phone layout and the default --- */

  .steps {
    display: grid;
    gap: 1.75rem;
  }

  .step {
    position: relative;
    padding-left: 2rem;
  }

  .step-node {
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--blue);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 4px rgba(41, 168, 233, 0.12);
  }

  .step-number {
    color: var(--muted);
  }

  .step h3 {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
  }

  .step p {
    margin-top: 0.3125rem;
  }

  /* The vertical line, on a pseudo element rather than on the SVG.
     Top to bottom needs no geometry, it is a straight drop down the gutter the
     nodes sit in, and a pseudo element stretches between a top and a bottom
     the way an SVG will not: an inline SVG is a replaced element, so with
     height auto it takes its height from its width and the viewBox's aspect
     ratio. At 2px wide that made the line 2px tall, which is to say invisible.

     It is the brand blue rather than a hairline, so it reads as the logo's
     growth line. Decorative: the sequence is carried by the ordered list and
     the numbers beside it. */
  .timeline::before {
    content: "";
    position: absolute;
    left: 0.375rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: var(--blue);
    opacity: 0.55;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .timeline[data-shown]::before {
    transform: scaleY(1);
  }

