---
/**
 * The homepage.
 *
 * Section order follows the Texas Roadside layout the redesign is modelled
 * on: dark image hero, a who-we-are split, a full width blue services band,
 * then the detail. Every word comes from src/content/site.ts,
 * src/content/pricing.ts or src/config/business.ts. Nothing is written here.
 *
 * Every image slot comes from src/content/images.ts, which says how to swap
 * a placeholder for a real photo.
 *
 * Animation is declared in the markup with data-animate and data-delay. The
 * system that reads them is in src/scripts/site.js and the motion itself is
 * at the bottom of src/styles/global.css.
 */
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { site } from "../content/site";
import { plans, pricingNote, planById } from "../content/pricing";
import { business, founders, real } from "../config/business";
import { images, altFor, type ImageKey } from "../content/images";
import { professionalService, faqPage } from "../content/structured-data";

const website = planById("website");
const legalName = real(business.legalName);

/* The image on each card in the blue band, by plan id. */
const cardImage: Record<string, ImageKey> = {
  landing: "serviceLanding",
  website: "serviceWebsite",
  retainer: "serviceContentAds",
};

/* Gap between staggered siblings, in ms. */
const STAGGER = 150;
---

<Base
  title={site.meta.title}
  description={site.meta.description}
  path="/"
  jsonLd={[professionalService(), faqPage()]}
>
  <!-- =============================================================== hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <!-- PHOTO SLOT: hero.webp. Behind a flat navy overlay. Not lazy: it is
         the first thing on the page. -->
    <img
      class="hero-bg"
      src={images.hero.src}
      width={images.hero.width}
      height={images.hero.height}
      alt={altFor(images.hero)}
      fetchpriority="high"
      decoding="async"
    />

    <div class="wrap hero-content">
      <h1 id="hero-heading" class="hero-rise">{site.hero.heading}</h1>
      <p class="hero-lede hero-rise" style="--rise-delay: 120ms">{site.hero.lede}</p>
      <p class="hero-price hero-rise" style="--rise-delay: 220ms">
        <strong>{website.amount}</strong>{" "}{site.hero.priceNote}
      </p>
      <div class="actions hero-rise" style="--rise-delay: 340ms">
        <a class="button button-outline" href="#contact">{site.hero.action}</a>
        <a class="button button-primary" href="#pricing">{site.hero.secondary}</a>
      </div>
    </div>
  </section>

  <!-- ========================================================= who we are -->
  <section class="section theme-paper" id="about" aria-labelledby="about-heading">
    <div class="wrap split">
      <div class="about-text" data-animate="slide-up" data-delay={STAGGER}>
        <p class="badge">{site.about.label}</p>
        <h2 id="about-heading">{site.about.heading}</h2>
        {site.about.paragraphs.map((text) => <p>{text}</p>)}
        <div class="actions">
          <a class="button button-primary" href="#contact">{site.hero.action}</a>
          <a class="button button-outline" href="#pricing">{site.hero.secondary}</a>
        </div>
      </div>

      <!-- PHOTO SLOT: who-we-are.webp -->
      <figure class="media" data-animate="slide-right">
        <img
          src={images.whoWeAre.src}
          width={images.whoWeAre.width}
          height={images.whoWeAre.height}
          alt={altFor(images.whoWeAre)}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ===================================================== services band -->
  <section class="band theme-blue" id="services" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="band-head">
        <h2 id="services-heading" class="band-heading">{site.band.heading}</h2>
      </div>

      <ul class="service-cards">
        {
          plans.map((plan, index) => {
            const image = images[cardImage[plan.id]];
            return (
              <li class="service-card" data-animate="slide-up" data-delay={index * STAGGER}>
                {/* PHOTO SLOT: see src/content/images.ts */}
                <img
                  src={image.src}
                  width={image.width}
                  height={image.height}
                  alt={altFor(image)}
                  loading="lazy"
                  decoding="async"
                />
                <div class="service-card-body">
                  <h3>{plan.name}</h3>
                  <p class="price">
                    <span class="price-figure">{plan.amount}</span>
                    <span class="price-unit">{plan.unit}</span>
                  </p>
                  <p class="service-card-summary">{plan.summary}</p>
                  <a class="service-card-link" href={`#plan-${plan.id}`}>
                    {site.band.cardLink}
                    <span class="visually-hidden">{` in the ${plan.name.toLowerCase()}`}</span>
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- ================================================== detailed pricing -->
  <section class="section theme-white" id="pricing" aria-labelledby="pricing-heading">
    <div class="wrap">
      <div class="section-head" data-animate="slide-up">
        <p class="badge">{site.services.label}</p>
        <h2 id="pricing-heading">{site.services.heading}</h2>
        <p class="intro">{site.services.intro}</p>
      </div>

      <div class="plan-rows">
        {
          plans.map((plan) => (
            <article class="plan-row" id={`plan-${plan.id}`} aria-labelledby={`plan-${plan.id}-name`}>
              <div class="plan-summary">
                <h3 id={`plan-${plan.id}-name`}>{plan.name}</h3>
                <p class="price">
                  <span class="price-figure">{plan.amount}</span>
                  <span class="price-unit">{plan.unit}</span>
                </p>
                <p class="plan-intro">{plan.summary}</p>
                <div class="facts">
                  <p class="fact">
                    <span class="fact-label">Payment</span>
                    {plan.payment}
                  </p>
                  {plan.timeline && (
                    <p class="fact">
                      <span class="fact-label">How long</span>
                      {plan.timeline}
                    </p>
                  )}
                </div>
              </div>

              <div class="plan-detail">
                {plan.includes && (
                  <ul class="ticks">
                    {plan.includes.map((item) => (
                      <li>
                        <Icon name="check" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {/* One service, two kinds of work. Each strand gets its own
                    deliverables and its own timeline, so a buyer sees
                    everything the monthly fee covers. */}
                {plan.parts?.map((part) => (
                  <div class="plan-part">
                    <h4>{part.name}</h4>
                    <p class="small plan-intro">{part.summary}</p>
                    <ul class="ticks">
                      {part.includes.map((item) => (
                        <li>
                          <Icon name="check" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="fact">
                      <span class="fact-label">How long</span>
                      {part.timeline}
                    </p>
                  </div>
                ))}

                <p class="excludes">{plan.excludes}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="small plan-note">{pricingNote}</p>
    </div>
  </section>

  <!-- ============================================================ why us -->
  <section class="section theme-dark" id="why" aria-labelledby="why-heading">
    <div class="wrap split">
      <!-- PHOTO SLOT: why-us.webp -->
      <figure class="media" data-animate="slide-left">
        <img
          src={images.whyUs.src}
          width={images.whyUs.width}
          height={images.whyUs.height}
          alt={altFor(images.whyUs)}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="why-text" data-animate="slide-up" data-delay={STAGGER}>
        <p class="badge">{site.whyUs.label}</p>
        <h2 id="why-heading">{site.whyUs.heading}</h2>
        <ul class="checklist">
          {
            site.whyUs.items.map((item) => (
              <li>
                <Icon name="check" />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ====================================================== how it works -->
  <section class="section theme-paper" id="process" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head" data-animate="slide-up">
        <p class="badge">{site.process.label}</p>
        <h2 id="process-heading">{site.process.heading}</h2>
        <p class="intro">{site.process.intro}</p>
      </div>

      {/* An ordered list, so the sequence survives with no CSS. The big
          number is decoration for sighted readers; a screen reader gets
          "Step 1." from the hidden text in the heading instead. */}
      <ol class="steps">
        {
          site.process.steps.map((step, index) => (
            <li class="step" data-animate="slide-up" data-delay={index * STAGGER}>
              <p class="step-number" aria-hidden="true">{index + 1}</p>
              <h3>
                <span class="visually-hidden">{`Step ${index + 1}. `}</span>
                {step.title}
              </h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="process-note">{site.process.note}</p>
    </div>
  </section>

  <!-- ========================================================== founders -->
  <section class="section theme-white" id="team" aria-labelledby="team-heading">
    <div class="wrap">
      <div class="section-head" data-animate="slide-up">
        <p class="badge">{site.team.label}</p>
        <h2 id="team-heading">{site.team.heading}</h2>
        <p class="intro">{site.team.intro}</p>
      </div>

      <ul class="founders">
        {
          founders.map((person, index) => {
            const photo = images[person.photo as ImageKey];
            return (
              <li class="founder" data-animate="slide-up" data-delay={index * STAGGER}>
                {/* PHOTO SLOT: see src/content/images.ts */}
                <img
                  class="founder-photo"
                  src={photo.src}
                  width="120"
                  height="120"
                  alt={altFor(photo)}
                  loading="lazy"
                  decoding="async"
                />

                <h3 class="founder-name">
                  <a
                    href={person.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${person.name} on LinkedIn (opens in new tab)`}
                  >
                    {person.name}
                    <Icon name="linkedin" />
                  </a>
                </h3>
                <p class="founder-role">{person.owns}</p>
                <p class="founder-major">{person.major}</p>
                <p class="founder-detail">{person.detail}</p>

                {/* BIO: fill in. Add a <p class="founder-detail"> here with a
                    real bio once the person has written or approved one.
                    Renders nothing until then. Do not invent details. */}
                <Fragment set:html={`<!-- BIO: fill in (${person.name}) -->`} />

                {person.site && (
                  <p class="founder-site">
                    <a
                      class="link"
                      href={person.site}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${person.name}'s personal site (opens in new tab)`}
                    >
                      Personal site
                    </a>
                  </p>
                )}
              </li>
            );
          })
        }
      </ul>

      <!-- The honesty block. The second sentence comes from the config, so
           the entity name and state cannot drift from the policy pages. -->
      <aside class="honesty" aria-label="About this business" data-animate="fade">
        <p>
          {site.team.note}
          {legalName && ` ${legalName} is registered in ${business.state}.`}
        </p>
      </aside>
    </div>
  </section>

  <!-- =============================================================== faq -->
  <section class="section theme-paper" id="faq" aria-labelledby="faq-heading">
    <div class="wrap">
      <div class="section-head" data-animate="slide-up">
        <p class="badge">{site.faq.label}</p>
        <h2 id="faq-heading">{site.faq.heading}</h2>
      </div>

      {/* Native details and summary. Keyboard operable, announced as
          expanded or collapsed, and searchable with find-in-page, all with
          no JavaScript. Each opens independently so a visitor can compare
          two answers. */}
      <div class="faq">
        {
          site.faq.items.map((item) => (
            <details class="faq-item">
              <summary>
                <span class="faq-q">{item.q}</span>
                <span class="faq-sign" aria-hidden="true" />
              </summary>
              <div class="faq-a">
                <p>{item.a}</p>
                {"link" in item && item.link && (
                  <p>
                    <a class="link" href={item.link.href}>
                      {item.link.label}
                    </a>
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= get a quote -->
  <section class="section theme-dark quote" id="contact" aria-labelledby="contact-heading">
    <div class="wrap">
      <h2 id="contact-heading" class="quote-banner" data-animate="fade">
        {site.contact.banner}
      </h2>

      <div class="split">
        <!-- PHOTO SLOT: quote.webp -->
        <figure class="media" data-animate="slide-left">
          <img
            src={images.quote.src}
            width={images.quote.width}
            height={images.quote.height}
            alt={altFor(images.quote)}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div data-animate="slide-right" data-delay={STAGGER}>
          <ContactForm />
          <p class="small contact-alt">
            You can email us directly at{" "}
            <a class="link" href={`mailto:${business.email}`}>{business.email}</a> if
            you would rather not use a form.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
