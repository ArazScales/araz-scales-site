---
/**
 * The homepage. Everything the brief asks for is on this one page, in the
 * order a visitor asks for it: what is this, what does it cost, how does it
 * work, who are you, the awkward questions, and then the form.
 *
 * Section order is deliberate. Price comes second because it is the thing an
 * owner wants and the thing an agency site hides.
 */
import Base from "../layouts/Base.astro";
import Record from "../components/Record.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../content/site";
import { plans, pricingNote } from "../content/pricing";
import { business, founders } from "../config/business";
---

<Base title={site.meta.title} description={site.meta.description} path="/">
  <!-- ------------------------------------------------------------- hero -->
  <section class="row hero">
    <div class="wrap stack" style="--flow: 1.25rem">
      <h1>{site.hero.heading}</h1>
      <p class="lede">{site.hero.lede}</p>
      <p>{site.hero.body}</p>
      <p style="margin-top: 0.75rem">
        <a class="button" href="#contact">{site.hero.action}</a>
      </p>
    </div>
  </section>

  <!-- --------------------------------------------------- services + price -->
  <Record id="services" question={site.services.question}>
    <div class="stack" style="--flow: 1rem">
      <p class="answer">{site.services.heading}</p>
      <p>{site.services.intro}</p>
    </div>

    <div class="plans">
      {
        plans.map((plan) => (
          <article class="plan">
            <div class="plan-price">
              <span class="figure">{plan.amount}</span>
              <span class="figure-unit">{plan.unit}</span>
            </div>

            <div class="plan-detail stack" style="--flow: 0.875rem">
              <h3>{plan.name}</h3>
              <p>{plan.summary}</p>

              {/* A single service: one list, one timeline. */}
              {plan.includes && (
                <ul class="ticks">
                  {plan.includes.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {plan.timeline && (
                <p class="plan-timeline">
                  <span class="plan-timeline-label">How long</span>
                  {plan.timeline}
                </p>
              )}

              {/* Two services under one price. Each gets its own
                  deliverables and its own timeline, so all three services on
                  the site are covered without printing $500 twice. */}
              {plan.parts?.map((part) => (
                <div class="plan-part">
                  <h4>{part.name}</h4>
                  <p>{part.summary}</p>
                  <ul class="ticks">
                    {part.includes.map((item) => <li>{item}</li>)}
                  </ul>
                  <p class="plan-timeline">
                    <span class="plan-timeline-label">How long</span>
                    {part.timeline}
                  </p>
                </div>
              ))}

              <p class="plan-excludes">{plan.excludes}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="small muted plan-note">{pricingNote}</p>
  </Record>

  <!-- ---------------------------------------------------------- process -->
  <Record id="process" question={site.process.question}>
    <div class="stack" style="--flow: 1rem">
      <p class="answer">{site.process.heading}</p>
      <p>{site.process.intro}</p>
    </div>

    <ol class="steps">
      {
        site.process.steps.map((step, index) => (
          <li class="step">
            <span class="step-number tabular" aria-hidden="true">
              {index + 1}
            </span>
            <div>
              <h3>
                <span class="visually-hidden">{`Step ${index + 1}. `}</span>
                {step.title}
              </h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="process-note">{site.process.note}</p>
  </Record>

  <!-- ------------------------------------------------------------- team -->
  <Record id="team" question={site.team.question}>
    <div class="stack" style="--flow: 1rem">
      <p class="answer">{site.team.heading}</p>
      <p>{site.team.intro}</p>
    </div>

    {/* PHOTO PLACEHOLDER. Three headshots are coming, one per founder. When
        they arrive: drop them in src/assets/, import them through Astro's
        <Image /> so they are sized and lazy loaded, and add one to each row
        below at around 96px square. The layout is finished without them and
        adding them does not change this structure. Record the source of each
        file in credits.md. Do not substitute a stock photo or an AI image. */}
    <ul class="founders">
      {
        founders.map((person) => (
          <li class="founder">
            <h3>{person.name}</h3>
            <p class="founder-owns">{person.owns}</p>
            <p class="small">{person.detail}</p>
          </li>
        ))
      }
    </ul>

    <p class="team-note">{site.team.note}</p>
  </Record>

  <!-- -------------------------------------------------------------- faq -->
  <Record id="faq" question={site.faq.question}>
    <div class="stack" style="--flow: 1rem">
      <p class="answer">{site.faq.heading}</p>
    </div>

    <dl class="faq">
      {
        site.faq.items.map((item) => (
          <div class="faq-item">
            <dt>{item.q}</dt>
            <dd>
              {item.a}
              {"link" in item && item.link && (
                <a class="faq-link" href={item.link.href}>
                  {item.link.label}
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </Record>

  <!-- ---------------------------------------------------------- contact -->
  <Record id="contact" question={site.contact.question}>
    <ContactForm />
    <p class="small muted contact-alt">
      You can email us directly at{" "}
      <a href={`mailto:${business.email}`}>{business.email}</a> if you would
      rather not use a form.
    </p>
  </Record>
</Base>

<style>
  /* ------------------------------------------------------------------ hero */

  .hero .wrap {
    padding-block: clamp(3rem, 10vw, 7.5rem) clamp(3rem, 8vw, 6rem);
  }

  /* --------------------------------------------------------------- plans */

  .plans {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .plan + .plan {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .plan {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
  }

  /* The figure gets its own column once there is room for it, so the number
     and the deliverables read side by side rather than stacked. */
  @media (min-width: 46rem) {
    .plan {
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      align-items: start;
    }
  }

  .plan-price {
    /* Optical alignment. The cap height of a figure this size sits lower than
       the h3 beside it, so nudge it up rather than leaving it looking dropped. */
    margin-top: -0.35rem;
  }

  /* The deliverables list runs far taller than the figure, which otherwise
     left a tall empty column beside it. Sticking the price keeps it level with
     whatever you are reading. Positioning, not animation.

     Nothing but the figure and its unit may live in this column: it is sized
     by its content, so a line of prose in here widens it and starves the list
     in the column beside it. */
  @media (min-width: 46rem) {
    .plan-price {
      position: sticky;
      top: 6rem;
    }
  }

  .plan-detail h3 {
    font-size: 1.25rem;
  }

  .plan-detail h4 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    font-variation-settings: "wdth" var(--width-display);
    letter-spacing: -0.005em;
  }

  .plan-part {
    padding-top: 0.5rem;
  }

  .plan-part > * + * {
    margin-top: 0.625rem;
  }

  .ticks li {
    position: relative;
    padding-left: 1.125rem;
    margin-top: 0.4375rem;
    max-width: var(--measure);
  }

  /* A short rule rather than a bullet or an icon. Keeps the list looking like
     part of a printed form. */
  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background: var(--ink);
  }

  .plan-timeline {
    max-width: var(--measure);
  }

  .plan-timeline-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 0.125rem;
  }

  .plan-excludes {
    padding-left: 0.75rem;
    border-left: 2px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .plan-note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* --------------------------------------------------------------- steps */

  .steps {
    margin-top: clamp(2rem, 5vw, 3rem);
    counter-reset: step;
  }

  .step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding-block: 1.125rem;
  }

  .step + .step {
    border-top: 1px solid var(--rule);
  }

  .step-number {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--muted);
  }

  .step p {
    margin-top: 0.3125rem;
  }

  .process-note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-left: 0.75rem;
    border-left: 2px solid var(--ink);
    font-size: 0.9375rem;
  }

  /* ------------------------------------------------------------ founders */

  .founders {
    display: grid;
    gap: 1.125rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 46rem) {
    .founders {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .founder {
    padding-top: 1.125rem;
    border-top: 1px solid var(--rule);
  }

  .founder-owns {
    margin-top: 0.1875rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }

  .founder .small {
    margin-top: 0.5rem;
  }

  .team-note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-left: 0.75rem;
    border-left: 2px solid var(--ink);
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  /* ----------------------------------------------------------------- faq */

  .faq {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .faq-item {
    padding-block: 1.125rem;
  }

  .faq-item + .faq-item {
    border-top: 1px solid var(--rule);
  }

  .faq dt {
    font-size: 1.0625rem;
    font-weight: 700;
    font-variation-settings: "wdth" var(--width-display);
    letter-spacing: -0.005em;
  }

  .faq dd {
    margin: 0.375rem 0 0;
    max-width: var(--measure);
  }

  .faq-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* ------------------------------------------------------------- contact */

  .contact-alt {
    margin-top: 1.75rem;
  }
</style>
