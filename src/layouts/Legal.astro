---
/**
 * Shell for the four policy pages.
 *
 * Same document feel as the homepage, narrower measure, and a back link
 * instead of the in page anchors. The "last updated" date comes from
 * business.policiesUpdated so all four pages move together.
 *
 * These pages are drafts. Nobody here is a lawyer. See the handoff notes in
 * the README before launch.
 */
import Base from "./Base.astro";
import { business, real, phoneDisplay, phoneHref } from "../config/business";

interface Props {
  title: string;
  description: string;
  path: string;
  /** The h1. Kept separate from the meta title. */
  heading: string;
  /** One plain sentence under the h1 saying what the page is for. */
  standfirst: string;
}

const { title, description, path, heading, standfirst } = Astro.props;
const address = real(business.address);
const phone = phoneDisplay();
const tel = phoneHref();
/* These pages are issued by the entity, not by the brand, so the line below
   the heading names it. Omitted entirely while no entity is filed, rather
   than falling back to the trading name, because a policy page that names a
   company is making a statement about who is bound by it. */
const legalName = real(business.legalName);
---

<Base title={title} description={description} path={path}>
  <section class="row">
    <div class="wrap legal">
      <div class="stack" style="--flow: 1rem">
        <h1>{heading}</h1>
        <p class="lede muted">{standfirst}</p>
        <p class="small muted">
          Last updated {business.policiesUpdated}.
          {legalName && ` Issued by ${legalName}, registered in ${business.state}.`}
        </p>
      </div>

      <div class="prose">
        <slot />

        <h2>How to reach us about this</h2>
        <p>
          Email <a class="link" href={`mailto:${business.email}`}>{business.email}</a> and one
          of the three of us will answer. Put the name of the policy in the
          subject line so it reaches the right person quickly.
        </p>
        {
          phone && tel && (
            <p>
              You can also call us on <a class="link" href={tel}>{phone}</a>.
            </p>
          )
        }
        {address && <p>Post reaches us at {address}.</p>}
      </div>

      <p class="back">
        <a class="link" href="/">Back to the homepage</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  .legal h1 {
    /* Shorter than the homepage h1. These are documents, not a pitch. */
    font-size: clamp(1.875rem, 4.4vw, 2.75rem);
  }

  .prose {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-weight: 600;
    max-width: none;
  }
</style>
