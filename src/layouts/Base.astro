---
/**
 * The shell every page uses: head, skip link, header, footer.
 *
 * Outbound requests from a rendered page: none. No analytics, no pixel, no
 * font CDN, no embed. The only network call the browser makes beyond the HTML
 * is for our own stylesheet, our own two font files, our own icons and one
 * small bundled script, all from this origin. The contact form posts to
 * Formspree on submit, which is a user action and not a load time request.
 * CLAUDE.md section 4 requires that this stays true, so anything added here
 * needs checking against it.
 */
import "../styles/global.css";
import { business, real, phoneDisplay, phoneHref } from "../config/business";
import { site } from "../content/site";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description: string;
  /** Path with a leading slash, for the canonical tag. */
  path: string;
  /**
   * JSON-LD blocks for this page, if it has any. Only the homepage does.
   * These are data blocks, not executable script, so they do not need the
   * Content Security Policy loosened.
   */
  jsonLd?: Record<string, unknown>[];
  /** Keeps a page out of the index. Only the 404 sets it. */
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const shareImage = new URL("/og.png", business.url).href;
const canonical = new URL(path, business.url).href;
const legal = site.footer.legalLinks;
const phone = phoneDisplay();
const tel = phoneHref();
/* The copyright line names the entity, not the brand, because that is the
   line that asserts who owns the thing. Falls back to the trading name while
   no entity is filed, so the footer never prints the placeholder. */
const owner = real(business.legalName) ?? business.name;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /* A 404 is reachable at any address, so a canonical tag on it would
         claim every mistyped URL as a real page. It gets noindex instead. */
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    <!-- Same origin. Archivo is on the critical path for every heading, so it
         is preloaded. The mono is not: it only sets small labels, and
         preloading both would make them compete for the first connection. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Matches the header's ground, so the phone's own chrome continues the
         page instead of capping it with a light bar. -->
    <meta name="theme-color" content="#141E29" />

    <!--
      The scroll reveal starts elements at zero opacity, and the script that
      reveals them cannot run without JavaScript. Both guards below put every
      element back to its finished state in that case, so the page is fully
      readable with scripting off rather than blank.

      Two of them because they cover different failures: `scripting: none` is
      the modern query and handles a browser with JS disabled, `noscript`
      handles the same case in older browsers. An inline <style> is used rather
      than an inline <script> because the Content Security Policy in
      vercel.json allows 'unsafe-inline' for styles and not for scripts.
    -->
    <style>
      @media (scripting: none) {
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      }
    </style>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Absolute, because a scraper resolves this without a document base.
         1200x630 is the ratio every one of them crops to, and declaring the
         dimensions lets the card reserve its space before the image lands. -->
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.shareImageAlt} />

    <!-- summary, the previous value, renders a small square thumbnail and
         would crop this card to its middle. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={site.meta.shareImageAlt} />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <header class="header">
      <div class="wrap header-inner">
        <Wordmark href="/" />
        <nav class="nav" aria-label="Sections of this page">
          {
            site.nav.map((item) => (
              <a href={path === "/" ? item.href : `/${item.href}`}>{item.label}</a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer band">
      <div class="wrap footer-wrap">
        <div class="footer-top">
          <div class="stack" style="--flow: 0.5rem">
            <Wordmark />
            <p class="small muted">
              {business.city}, {business.state}
            </p>
          </div>

          <div class="stack" style="--flow: 0.375rem">
            <p class="small">
              <a class="link" href={`mailto:${business.email}`}>{business.email}</a>
            </p>
            {
              phone && tel && (
                <p class="small">
                  <a class="link" href={tel}>{phone}</a>
                </p>
              )
            }
          </div>

          <nav class="footer-legal" aria-label="Policies">
            {legal.map((item) => <a class="small" href={item.href}>{item.label}</a>)}
          </nav>
        </div>

        <p class="small muted footer-bottom">
          &copy; {year} {owner}. {business.city}, {business.state}.
        </p>
      </div>
    </footer>

    <style>
      .footer {
        border-top: 1px solid var(--line);
      }

      .footer-wrap {
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .footer-top {
        display: grid;
        gap: 2rem;
      }

      @media (min-width: 48rem) {
        .footer-top {
          grid-template-columns: 1fr auto auto;
          gap: 3rem;
          align-items: start;
        }
      }

      .footer-legal {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.25rem;
      }

      .footer-legal a {
        color: var(--muted);
        text-decoration: none;
        transition: color 140ms ease;
      }

      .footer-legal a:hover {
        color: var(--blue-bright);
        text-decoration: underline;
      }

      .footer-bottom {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        /* p carries a 64ch measure globally, which would cut the divider rule
           short of the footer's width. */
        max-width: none;
      }
    </style>

    <script>
      /* The page's only script besides the contact form.
       *
       * Two jobs: reveal sections as they scroll into view, and run the hero's
       * rotating word. Both are decoration. Neither adds, removes or reorders
       * any content, so the page is complete without it, and both are skipped
       * outright when the visitor has asked for reduced motion.
       *
       * Bundled rather than inline so the Content Security Policy in
       * vercel.json can stay at script-src 'self' with no 'unsafe-inline'.
       */
      (() => {
        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        /* ------------------------------------------------------- reveals */

        const revealables = document.querySelectorAll("[data-reveal]");

        /* Reveal everything at once rather than leaving it invisible. Used
           when the visitor asked for no motion, and as the fallback on a
           browser with no IntersectionObserver. */
        const showAll = () => {
          for (const el of revealables) el.setAttribute("data-shown", "");
          for (const el of document.querySelectorAll(".timeline"))
            el.setAttribute("data-shown", "");
        };

        /* `document.hidden` matters here and is not paranoia. A document that
           is hidden, a tab opened in the background with a middle click, a
           restored session, a prerender, gets no IntersectionObserver
           callbacks at all: not deferred ones, none, even for an element
           sitting in the middle of the viewport. Without this branch every
           section would stay at zero opacity until the visitor switched to
           the tab, which is a blank page for as long as they take to get
           there. Revealing up front costs nothing, because nobody is watching
           an animation on a tab they are not looking at. */
        if (reduced || document.hidden || !("IntersectionObserver" in window)) {
          showAll();
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.setAttribute("data-shown", "");
                /* Once only. Nothing re-hides on the way back up, so
                   scrolling a section past twice does not replay it. */
                observer.unobserve(entry.target);
              }
            },
            /* Fires a little before the element's top edge reaches the
               bottom of the viewport, so a section has finished arriving by
               the time it is properly on screen. */
            { rootMargin: "0px 0px -12% 0px", threshold: 0.01 }
          );

          for (const el of revealables) observer.observe(el);

          /* The process line draws itself on its own container rather than
             per step, so the whole line is one stroke. */
          for (const el of document.querySelectorAll(".timeline"))
            observer.observe(el);
        }

        /* ------------------------------------------------- rotating word */

        const rotator = document.getElementById("rotator");
        if (!rotator || reduced) return;

        let words;
        try {
          words = JSON.parse(rotator.dataset.words || "[]");
        } catch {
          return;
        }
        if (!Array.isArray(words) || words.length < 2) return;

        const TYPE = 95;
        const DELETE = 45;
        const HOLD = 1600;
        const GAP = 420;

        let index = 0;
        let letters = words[0].length;
        let deleting = true;
        let timer = 0;

        const tick = () => {
          const word = words[index];

          if (deleting) {
            letters -= 1;
            if (letters <= 0) {
              deleting = false;
              index = (index + 1) % words.length;
              rotator.textContent = "";
              timer = window.setTimeout(tick, GAP);
              return;
            }
          } else {
            letters += 1;
            if (letters >= word.length) {
              rotator.textContent = word;
              deleting = true;
              timer = window.setTimeout(tick, HOLD);
              return;
            }
          }

          rotator.textContent = word.slice(0, letters);
          timer = window.setTimeout(tick, deleting ? DELETE : TYPE);
        };

        /* Hold the first word a beat before anything moves, so the line reads
           as a sentence before it starts behaving like an animation. */
        timer = window.setTimeout(tick, 2200);

        /* A background tab throttles timers and the word ends up mid-delete
           when the visitor comes back. Stop on hide, restart clean on show. */
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            window.clearTimeout(timer);
          } else {
            window.clearTimeout(timer);
            rotator.textContent = words[index];
            letters = words[index].length;
            deleting = true;
            timer = window.setTimeout(tick, HOLD);
          }
        });
      })();
    </script>
  </body>
</html>
