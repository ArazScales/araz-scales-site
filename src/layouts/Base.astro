---
/**
 * The shell every page uses: head, skip link, header, footer.
 *
 * Outbound requests from a rendered page: none. No analytics, no pixel, no
 * font CDN, no embed. The only network call the browser makes beyond the HTML
 * is for our own stylesheet, our own font file and our own icons, all from
 * this origin. The contact form posts to Formspree on submit, which is a user
 * action and not a load time request. CLAUDE.md section 4 requires that this
 * stays true, so anything added here needs checking against it.
 */
import "../styles/global.css";
import { business, real } from "../config/business";
import { site } from "../content/site";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description: string;
  /** Path with a leading slash, for the canonical tag. */
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = new URL(path, business.url).href;
const legal = site.footer.legalLinks;
const phone = real(business.phone);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Same origin, and the only font on the site, so preloading it removes
         the swap flash without costing a round trip. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4F5F7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <header class="header">
      <div class="wrap header-inner">
        <Wordmark href="/" />
        <nav class="nav" aria-label="Sections of this page">
          {
            site.nav.map((item) => (
              <a href={path === "/" ? item.href : `/${item.href}`}>{item.label}</a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="band">
      <div class="wrap" style="padding-block: clamp(2.5rem, 6vw, 4rem)">
        <div class="footer-top">
          <div class="stack" style="--flow: 0.5rem">
            <Wordmark />
            <p class="small muted">
              {business.city}, {business.state}
            </p>
          </div>

          <div class="stack" style="--flow: 0.375rem">
            <p class="small">
              <a href={`mailto:${business.email}`}>{business.email}</a>
            </p>
            {
              phone && (
                <p class="small">
                  <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>{phone}</a>
                </p>
              )
            }
          </div>

          <nav class="footer-legal" aria-label="Policies">
            {legal.map((item) => <a class="small" href={item.href}>{item.label}</a>)}
          </nav>
        </div>

        <p class="small muted divider footer-bottom">
          &copy; {year} {business.name} &middot; {business.city}, {business.state}
        </p>
      </div>
    </footer>

    <style>
      .footer-top {
        display: grid;
        gap: 2rem;
      }

      @media (min-width: 48rem) {
        .footer-top {
          grid-template-columns: 1fr auto auto;
          gap: 3rem;
          align-items: start;
        }
      }

      .footer-legal {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.25rem;
      }

      .footer-bottom {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        /* p carries a 64ch measure globally, which would cut the divider rule
           short of the footer's width. */
        max-width: none;
      }
    </style>
  </body>
</html>
