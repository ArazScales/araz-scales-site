---
/**
 * The shell every page uses: head, info bar, header, footer.
 *
 * Outbound requests from a rendered page: none. No analytics, no pixel, no
 * font CDN, no embed. The browser asks this origin for the HTML, one
 * stylesheet, one font file, one script, the logo, the icons and the images
 * on the page, and nothing else. The contact form posts to Formspree on
 * submit, which is a user action and not a load time request. CLAUDE.md
 * section 4 requires that this stays true.
 */
import "../styles/global.css";
import { business, real, phoneDisplay, phoneHref } from "../config/business";
import { site } from "../content/site";
import Wordmark from "../components/Wordmark.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
  /** Path with a leading slash, for the canonical tag. */
  path: string;
  /**
   * JSON-LD blocks for this page, if it has any. Only the homepage does.
   * These are data blocks, not executable script, so they do not need the
   * Content Security Policy loosened.
   */
  jsonLd?: Record<string, unknown>[];
  /** Keeps a page out of the index. Only the 404 sets it. */
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const shareImage = new URL("/og.png", business.url).href;
const canonical = new URL(path, business.url).href;
const legal = site.footer.legalLinks;
const phone = phoneDisplay();
const tel = phoneHref();
/* The copyright line names the entity, not the brand, because that is the
   line that asserts who owns the thing. */
const owner = real(business.legalName) ?? business.name;
const year = new Date().getFullYear();
const place = `${business.city}, ${business.state}`;

/* On the homepage the nav is in-page anchors. Anywhere else it points back
   at the homepage section. */
const anchor = (href: string) => (path === "/" ? href : `/${href}`);

/* Only profiles with a real URL get an icon. An unset one renders nothing,
   so there is never a dead "#" link in the bar. */
const socialLabels = {
  linkedin: "LinkedIn",
  instagram: "Instagram",
  facebook: "Facebook",
} as const;
const socials = (Object.keys(socialLabels) as (keyof typeof socialLabels)[])
  .map((key) => ({ key, url: real(business.social[key]), label: socialLabels[key] }))
  .filter((entry): entry is { key: keyof typeof socialLabels; url: string; label: string } =>
    entry.url !== null
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Marks the document as scripted before the first paint, so the CSS can
      put animated elements in their starting position without a flash. With
      JavaScript off this never runs, the class is never set, and every
      element renders in place.

      It also carries a fail-safe. If site.js has not checked in within four
      seconds (blocked, failed, or a very slow connection), the class comes
      off again and everything shows, rather than the page sitting there
      with hidden sections.

      Inline, so it is allowed by its SHA-256 hash in the Content Security
      Policy in vercel.json rather than by 'unsafe-inline'. Changing a single
      character here changes the hash: re-run `npm run csp-hash` and paste
      the result into vercel.json, or the browser will block it.
    -->
    <script is:inline>document.documentElement.classList.add("js");setTimeout(function(){if(!window.ARAZ_READY)document.documentElement.classList.remove("js")},4000);</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /* A 404 is reachable at any address, so a canonical tag on it would
         claim every mistyped URL as a real page. It gets noindex instead. */
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Matches the header, so the phone's own chrome continues it. -->
    <meta name="theme-color" content="#0A0E1A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Absolute, because a scraper resolves this without a document base.
         1200x630 is the ratio every one of them crops to, and declaring the
         dimensions lets the card reserve its space before the image lands. -->
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.shareImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={site.meta.shareImageAlt} />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <!-- ------------------------------------------------------- info bar -->
    <!-- A labelled landmark, so its contents are not orphaned outside every
         region of the page. -->
    <aside class="topbar" aria-label="Contact details">
      <div class="wrap topbar-inner">
        <ul class="topbar-info">
          <li>
            <Icon name="mail" />
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </li>
          <li>
            <Icon name="map-pin" />
            <span>{place}</span>
          </li>
        </ul>

        {
          socials.length > 0 && (
            <ul class="social" aria-label="ARAZ Scales on social media">
              {socials.map((entry) => (
                <li>
                  <a
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${business.name} on ${entry.label} (opens in new tab)`}
                  >
                    <Icon name={entry.key} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </aside>

    <!-- --------------------------------------------------------- header -->
    <header class="header">
      <div class="wrap header-inner">
        <Wordmark href="/" />

        <!-- Hidden until site.js runs, and only shown below the desktop
             breakpoint. Without JavaScript the links simply sit in a row of
             their own under the logo, so nothing is ever unreachable. -->
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menu"
        >
          <Icon name="menu" class="icon-open" />
          <Icon name="x" class="icon-close" />
        </button>

        <nav class="nav" id="site-nav" aria-label="Main">
          <ul>
            {
              site.nav.map((item) => (
                <li>
                  <a href={anchor(item.href)}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- After the nav in the source, so Tab goes from the menu button
             straight into the links it opens. On a desktop it is last in
             the row anyway. Between 40rem and 64rem it is pulled forward
             visually to sit beside the menu button. -->
        <a class="button button-primary header-cta" href={anchor("#contact")}>
          {site.hero.action}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- --------------------------------------------------------- footer -->
    <footer class="footer theme-dark">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <Wordmark />
            <p class="muted small">{site.footer.description}</p>
          </div>

          <nav aria-labelledby="footer-links">
            <h2 id="footer-links">Quick links</h2>
            <ul class="footer-list">
              {
                site.nav.map((item) => (
                  <li>
                    <a href={anchor(item.href)}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div>
            <h2>Contact</h2>
            <ul class="footer-list">
              <li>
                <Icon name="mail" />
                <a href={`mailto:${business.email}`}>{business.email}</a>
              </li>
              {
                phone && tel && (
                  <li>
                    <Icon name="phone" />
                    <a href={tel}>{phone}</a>
                  </li>
                )
              }
              <li>
                <Icon name="map-pin" />
                <span>{place}</span>
              </li>
            </ul>
          </div>

          <nav aria-labelledby="footer-legal">
            <h2 id="footer-legal">Legal</h2>
            <ul class="footer-list">
              {
                legal.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <p class="small muted footer-bottom">
          &copy; {year} {owner} &middot; {place}
        </p>
      </div>
    </footer>

    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
