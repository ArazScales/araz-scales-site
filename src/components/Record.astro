---
/**
 * One section of the homepage.
 *
 * The old two column record put the visitor's question in a sticky left rail
 * and the answer beside it. That layout gave a third of every row to a four
 * word label and left the content in a narrow column, which is the wrong trade
 * once the content is cards rather than paragraphs.
 *
 * Now the question is a mono label across the top, marked with the hollow ring
 * node lifted from the logo, and the body gets the full width beneath it. The
 * props are unchanged, so the pages using this did not have to move.
 *
 * `deep` sits the section on the darker ground. Use it sparingly: the page is
 * a run of hairline separated rows, and one section changing ground means
 * something only while it is the only one that does.
 */
interface Props {
  id: string;
  question: string;
  /** Sit this section on the deeper ground instead of the page ground. */
  deep?: boolean;
  /** Draw the faint grid behind this section. Hero and contact only. */
  grid?: boolean;
}
const { id, question, deep = false, grid = false } = Astro.props;
---

<section
  class:list={["row", { band: deep, "grid-ground": grid }]}
  id={id}
  aria-labelledby={`${id}-question`}
>
  <div class="wrap">
    <h2 class="section-head mono" id={`${id}-question`}>{question}</h2>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  /* The body column just needs a minimum width so a long unbroken word cannot
     force a horizontal scrollbar at 320px. */
  .section-body {
    min-width: 0;
  }

  /* The h2 is set at mono label size, which is smaller than the `.answer`
     line beneath it. That inverts the usual size hierarchy on purpose: the
     question is a tab on a file, the answer is the content of it. The heading
     order in the document is still correct, which is what a screen reader
     and an outline tool read. */
  .section-head {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.12em;
  }
</style>
