---
/**
 * The ARAZ mark plus the name.
 *
 * The mark is a raster PNG, not an inline SVG, because the logo we were given
 * is a raster export and there is no vector source. That has one consequence
 * worth knowing: the old three-bar mark was inline and inherited
 * `currentColor`, so it flipped to ink in the header and stock on the footer
 * band. This one is a fixed brand blue in both places, which is why
 * `--accent` was moved to the mark's own #039CD8 rather than the other way
 * round. Do not recolour, stretch or filter it.
 *
 * `width` and `height` are set so the row reserves its space before the image
 * lands. Without them the header reflows on first paint and the page picks up
 * layout shift, which the performance floor in CLAUDE.md section 6 forbids.
 *
 * public/logo-mark.png is a 96px wide export of src/logo-mark-master.png,
 * which is 3x the 29px it is drawn at. Larger than that and Lighthouse flags
 * it as an oversized image.
 * scripts/generate-icons.mjs builds the favicon set from that same master.
 */
interface Props {
  /** Renders as a link when set. The footer passes nothing. */
  href?: string;
  class?: string;
}
const { href, class: className } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["wordmark", className]} {...href ? { href } : {}}>
  <img src="/logo-mark.png" alt="" width="29" height="22" decoding="async" />
  ARAZ Scales
</Tag>
